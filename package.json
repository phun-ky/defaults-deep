{
  "name": "@phun-ky/defaults-deep",
  "version": "2.0.9",
  "description": "Like lodash's _.defaultsDeep, but with array preservation",
  "type": "module",
  "main": "./dist/defaults-deep.cjs",
  "module": "./dist/defaults-deep.js",
  "types": "./dist/defaults-deep.d.cts",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-ISC"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/defaults-deep.d.ts",
        "default": "./dist/defaults-deep.js"
      },
      "require": {
        "types": "./dist/defaults-deep.d.cts",
        "default": "./dist/defaults-deep.cjs"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": false,
  "scripts": {
    "bestpractices:url": "node scripts/bestpractices-url.mjs",
    "build": "npm run clean && npm run rollup",
    "check:bestpractices": "node scripts/check-bestpractices.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "clean": "rm -rf dist dts",
    "commit": "npx git-cz",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors",
    "docs:gen": "node ./node_modules/.bin/typedoc",
    "prepare": "git config core.hooksPath .githooks || true",
    "prerollup:dev": "npm run clean",
    "pretest:ci": "rm -rf coverage && mkdir -p coverage",
    "release": "release-it",
    "release:dry-run": ".github/scripts/should-release.sh && release-it --ci --dry-run --github.release=false --no-git.requireCleanWorkingDir --no-git.requireUpstream",
    "rollup": "rollup -c",
    "rollup:dev": "rollup -c -w",
    "sbom": "node scripts/sbom.mjs",
    "style:format": "eslint . --fix && prettier --write \"**/*.{json,yml,yaml}\"",
    "style:format-check": "prettier --check \"**/*.{json,yml,yaml}\"",
    "style:lint": "eslint .",
    "test": "node --import tsx --test --enable-source-maps \"src/**/__tests__/**/*.ts\"",
    "test:ci": "node --import tsx --test --enable-source-maps --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/__tests__/**\" --test-coverage-lines=99 --test-coverage-functions=100 --test-coverage-branches=97 --test-reporter=cobertura --test-reporter-destination=coverage/cobertura-coverage.xml --test-reporter=spec --test-reporter-destination=stdout \"src/**/__tests__/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "funding": "https://github.com/phun-ky/defaults-deep?sponsor=1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/defaults-deep.git"
  },
  "keywords": [
    "node-utils",
    "node",
    "javascript",
    "typescript",
    "esm",
    "utility",
    "utils",
    "object",
    "object-utils",
    "object-merge",
    "deep-merge",
    "deepmerge",
    "merge",
    "mergeWith",
    "merge-customizer",
    "customizer",
    "defaults",
    "defaultsdeep",
    "deep-defaults",
    "config",
    "configuration",
    "settings",
    "options",
    "preset",
    "overrides",
    "override",
    "assign",
    "extend",
    "mixin",
    "combine",
    "compose",
    "nested",
    "recursive",
    "immutable",
    "mutate",
    "clone",
    "array",
    "arrays",
    "array-merge",
    "array-preserve",
    "array-preservation",
    "array-replace",
    "array-overwrite",
    "lodash",
    "lodash-alternative",
    "lodash-replacement",
    "lodash-compat",
    "lightweight"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "author": {
    "name": "Alexander Vassbotn Røyne-Helgesen",
    "email": "alexander@phun-ky.net"
  },
  "contributors": [
    "Drew Llewellyn <drew@drew.pro> (https://drew.pro)"
  ],
  "maintainers": [
    {
      "name": "Alexander Vassbotn Røyne-Helgesen",
      "email": "alexander@phun-ky.net"
    }
  ],
  "license": "MIT AND ISC",
  "bugs": {
    "url": "https://github.com/phun-ky/defaults-deep/issues"
  },
  "homepage": "https://github.com/phun-ky/defaults-deep#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@release-it/conventional-changelog": "^12.0.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.19.2",
    "cobertura": "^1.0.1",
    "eslint": "^10.0.0",
    "eslint-config-phun-ky": "^2.0.10",
    "fast-check": "^4.10.2",
    "git-cz": "^4.9.0",
    "globals": "^17.13.0",
    "prettier": "^3.8.0",
    "publint": "^0.3.25",
    "release-it": "^21.1.1",
    "remark-github": "^12.0.0",
    "remark-toc": "^9.0.0",
    "rollup": "^4.12.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "tsx": "^4.7.1",
    "typedoc": "^0.28.2",
    "typedoc-plugin-markdown": "^4.2.3",
    "typedoc-plugin-mdn-links": "^5.0.1",
    "typedoc-plugin-remark": "^2.0.0",
    "typedoc-plugin-rename-defaults": "^0.7.1",
    "typescript": "^7.0.2",
    "unified-prettier": "^2.0.1"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.3"
    },
    "release-it": {
      "undici": "^7.30.1"
    },
    "micromark-extension-math": {
      "katex": "^0.18.2"
    }
  },
  "dependencies": {
    "@phun-ky/typeof": "^3.0.9"
  }
}
